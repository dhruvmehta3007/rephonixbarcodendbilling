{
  "name": "thecellpointbarcode",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && npm run seed",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/index.mjs --packages=external",
    "build:client": "vite build",
    "build": "prisma db push && npm run seed && vite build",
    "seed": "tsx server/seed.ts",
    "db:clean": "tsx server/reset-clean-db.ts",
    "seed:sample": "tsx server/seed-sample.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "npm run build:server && electron electron/main.cjs",
    "dist:exe": "npm run build:server && vite build && electron-builder --win"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/node": "^26.6.6",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.64.0",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.thecellpoint.pos",
    "productName": "THE CELL POINT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "prisma/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@prisma/**",
      "**/node_modules/prisma/**",
      "**/prisma/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "THE CELL POINT"
    }
  }
}
